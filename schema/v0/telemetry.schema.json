{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://raw.githubusercontent.com/byobot/byobot/main/schema/v0/telemetry.schema.json",
  "title": "byobot telemetry sample, v0",
  "description": "One measurement from a device or service. Samples are keyed on (source, source_id), so importing the same data twice changes nothing. Types use HealthKit identifiers where HealthKit has one; `byobot.` types fill the gaps. Values use one canonical unit per type.",
  "type": "object",
  "additionalProperties": false,
  "required": ["source", "source_id", "type", "start", "end", "value"],
  "properties": {
    "source": { "$ref": "common.schema.json#/$defs/slug", "description": "Where the sample came from, for example `whoop`, `hume`, `apple-health`." },
    "source_id": { "type": "string", "minLength": 1, "maxLength": 256, "description": "The source's own id for this sample, stable across re-imports." },
    "type": {
      "enum": [
        "HKQuantityTypeIdentifierBodyMass",
        "HKQuantityTypeIdentifierBodyFatPercentage",
        "HKQuantityTypeIdentifierLeanBodyMass",
        "HKQuantityTypeIdentifierVO2Max",
        "HKQuantityTypeIdentifierHeartRateVariabilitySDNN",
        "byobot.HeartRateVariabilityRMSSD",
        "HKQuantityTypeIdentifierRestingHeartRate",
        "HKCategoryTypeIdentifierSleepAnalysis",
        "HKQuantityTypeIdentifierOxygenSaturation",
        "HKQuantityTypeIdentifierRespiratoryRate",
        "byobot.SkinTemperature",
        "byobot.SleepLightDuration",
        "byobot.SleepDeepDuration",
        "byobot.SleepREMDuration",
        "byobot.SleepAwakeDuration",
        "byobot.SleepPerformance",
        "byobot.RecoveryScore",
        "byobot.Strain",
        "HKQuantityTypeIdentifierStepCount",
        "HKQuantityTypeIdentifierDistanceWalkingRunning",
        "HKQuantityTypeIdentifierDistanceCycling",
        "HKQuantityTypeIdentifierDistanceSwimming",
        "HKQuantityTypeIdentifierFlightsClimbed",
        "HKQuantityTypeIdentifierActiveEnergyBurned",
        "HKQuantityTypeIdentifierBasalEnergyBurned",
        "HKQuantityTypeIdentifierAppleExerciseTime",
        "HKQuantityTypeIdentifierAppleStandTime",
        "HKQuantityTypeIdentifierHeartRate",
        "HKQuantityTypeIdentifierWalkingHeartRateAverage",
        "HKQuantityTypeIdentifierHeartRateRecoveryOneMinute",
        "HKQuantityTypeIdentifierWalkingSpeed",
        "HKQuantityTypeIdentifierWalkingStepLength",
        "HKQuantityTypeIdentifierWalkingDoubleSupportPercentage",
        "HKQuantityTypeIdentifierWalkingAsymmetryPercentage",
        "HKQuantityTypeIdentifierAppleWalkingSteadiness",
        "HKQuantityTypeIdentifierSixMinuteWalkTestDistance",
        "HKQuantityTypeIdentifierStairAscentSpeed",
        "HKQuantityTypeIdentifierStairDescentSpeed",
        "HKQuantityTypeIdentifierBloodPressureSystolic",
        "HKQuantityTypeIdentifierBloodPressureDiastolic",
        "HKQuantityTypeIdentifierBloodGlucose",
        "HKQuantityTypeIdentifierBodyTemperature",
        "HKQuantityTypeIdentifierAppleSleepingWristTemperature",
        "HKQuantityTypeIdentifierHeight",
        "HKQuantityTypeIdentifierBodyMassIndex",
        "HKQuantityTypeIdentifierWaistCircumference",
        "HKWorkoutTypeIdentifier"
      ],
      "description": "Sleep stage durations are totals for one sleep, for sources with no stage-by-stage timeline. Scores are the source's own and stay tied to it. A workout's value is its HealthKit activity type, such as `traditionalStrengthTraining`, and its totals are in `raw`. Apple Health's activity totals and heart rate arrive one sample per day, from the day's start to its end: a sum, or for heart rate the day's average with `min_bpm` and `max_bpm` in `raw`."
    },
    "start": { "$ref": "common.schema.json#/$defs/timestamp" },
    "end": { "$ref": "common.schema.json#/$defs/timestamp" },
    "value": { "type": ["number", "string"] },
    "unit": { "type": "string" },
    "device": { "$ref": "#/$defs/device" },
    "raw": { "description": "The source's original record, kept as-is so canonical rows can be rebuilt." }
  },
  "allOf": [
    {
      "if": { "properties": { "type": { "enum": ["HKQuantityTypeIdentifierBodyMass", "HKQuantityTypeIdentifierLeanBodyMass"] } }, "required": ["type"] },
      "then": {
        "required": ["unit"],
        "properties": { "value": { "type": "number", "exclusiveMinimum": 0, "maximum": 700 }, "unit": { "const": "kg" } }
      }
    },
    {
      "if": { "properties": { "type": { "enum": ["HKQuantityTypeIdentifierHeartRateVariabilitySDNN", "byobot.HeartRateVariabilityRMSSD"] } }, "required": ["type"] },
      "then": {
        "required": ["unit"],
        "properties": { "value": { "type": "number", "exclusiveMinimum": 0, "maximum": 1000 }, "unit": { "const": "ms" } }
      }
    },
    {
      "if": { "properties": { "type": { "enum": ["HKQuantityTypeIdentifierRestingHeartRate", "HKQuantityTypeIdentifierHeartRate", "HKQuantityTypeIdentifierWalkingHeartRateAverage", "HKQuantityTypeIdentifierHeartRateRecoveryOneMinute"] } }, "required": ["type"] },
      "then": {
        "required": ["unit"],
        "properties": { "value": { "type": "number", "exclusiveMinimum": 0, "maximum": 300 }, "unit": { "const": "count/min" } }
      }
    },
    {
      "if": { "properties": { "type": { "const": "HKCategoryTypeIdentifierSleepAnalysis" } }, "required": ["type"] },
      "then": {
        "not": { "required": ["unit"] },
        "properties": { "value": { "enum": ["inBed", "asleepUnspecified", "awake", "asleepCore", "asleepDeep", "asleepREM"] } }
      }
    },
    {
      "if": { "properties": { "type": { "enum": ["HKQuantityTypeIdentifierOxygenSaturation", "HKQuantityTypeIdentifierWalkingDoubleSupportPercentage", "HKQuantityTypeIdentifierWalkingAsymmetryPercentage", "HKQuantityTypeIdentifierAppleWalkingSteadiness", "HKQuantityTypeIdentifierBodyFatPercentage", "byobot.SleepPerformance", "byobot.RecoveryScore"] } }, "required": ["type"] },
      "then": {
        "required": ["unit"],
        "properties": { "value": { "type": "number", "minimum": 0, "maximum": 100 }, "unit": { "const": "%" } }
      }
    },
    {
      "if": { "properties": { "type": { "const": "HKQuantityTypeIdentifierRespiratoryRate" } }, "required": ["type"] },
      "then": {
        "required": ["unit"],
        "properties": { "value": { "type": "number", "exclusiveMinimum": 0, "maximum": 100 }, "unit": { "const": "count/min" } }
      }
    },
    {
      "if": { "properties": { "type": { "enum": ["byobot.SkinTemperature", "HKQuantityTypeIdentifierBodyTemperature", "HKQuantityTypeIdentifierAppleSleepingWristTemperature"] } }, "required": ["type"] },
      "then": {
        "required": ["unit"],
        "properties": { "value": { "type": "number", "exclusiveMinimum": 0, "maximum": 50 }, "unit": { "const": "degC" } }
      }
    },
    {
      "if": { "properties": { "type": { "enum": ["byobot.SleepLightDuration", "byobot.SleepDeepDuration", "byobot.SleepREMDuration", "byobot.SleepAwakeDuration"] } }, "required": ["type"] },
      "then": {
        "required": ["unit"],
        "properties": { "value": { "type": "number", "minimum": 0, "maximum": 86400 }, "unit": { "const": "s" } }
      }
    },
    {
      "if": { "properties": { "type": { "const": "byobot.Strain" } }, "required": ["type"] },
      "then": {
        "not": { "required": ["unit"] },
        "properties": { "value": { "type": "number", "minimum": 0, "maximum": 21 } }
      }
    },
    {
      "if": { "properties": { "type": { "const": "HKQuantityTypeIdentifierVO2Max" } }, "required": ["type"] },
      "then": {
        "required": ["unit"],
        "properties": { "value": { "type": "number", "exclusiveMinimum": 0, "maximum": 100 }, "unit": { "const": "ml/kg*min" } }
      }
    },
    {
      "if": { "properties": { "type": { "enum": ["HKQuantityTypeIdentifierStepCount", "HKQuantityTypeIdentifierFlightsClimbed"] } }, "required": ["type"] },
      "then": {
        "required": ["unit"],
        "properties": { "value": { "type": "number", "minimum": 0, "maximum": 200000 }, "unit": { "const": "count" } }
      }
    },
    {
      "if": { "properties": { "type": { "enum": ["HKQuantityTypeIdentifierDistanceWalkingRunning", "HKQuantityTypeIdentifierDistanceCycling", "HKQuantityTypeIdentifierDistanceSwimming", "HKQuantityTypeIdentifierSixMinuteWalkTestDistance"] } }, "required": ["type"] },
      "then": {
        "required": ["unit"],
        "properties": { "value": { "type": "number", "minimum": 0, "maximum": 1000000 }, "unit": { "const": "m" } }
      }
    },
    {
      "if": { "properties": { "type": { "enum": ["HKQuantityTypeIdentifierActiveEnergyBurned", "HKQuantityTypeIdentifierBasalEnergyBurned"] } }, "required": ["type"] },
      "then": {
        "required": ["unit"],
        "properties": { "value": { "type": "number", "minimum": 0, "maximum": 50000 }, "unit": { "const": "kcal" } }
      }
    },
    {
      "if": { "properties": { "type": { "enum": ["HKQuantityTypeIdentifierAppleExerciseTime", "HKQuantityTypeIdentifierAppleStandTime"] } }, "required": ["type"] },
      "then": {
        "required": ["unit"],
        "properties": { "value": { "type": "number", "minimum": 0, "maximum": 86400 }, "unit": { "const": "s" } }
      }
    },
    {
      "if": { "properties": { "type": { "enum": ["HKQuantityTypeIdentifierWalkingSpeed", "HKQuantityTypeIdentifierStairAscentSpeed", "HKQuantityTypeIdentifierStairDescentSpeed"] } }, "required": ["type"] },
      "then": {
        "required": ["unit"],
        "properties": { "value": { "type": "number", "exclusiveMinimum": 0, "maximum": 20 }, "unit": { "const": "m/s" } }
      }
    },
    {
      "if": { "properties": { "type": { "enum": ["HKQuantityTypeIdentifierWalkingStepLength", "HKQuantityTypeIdentifierHeight", "HKQuantityTypeIdentifierWaistCircumference"] } }, "required": ["type"] },
      "then": {
        "required": ["unit"],
        "properties": { "value": { "type": "number", "exclusiveMinimum": 0, "maximum": 5 }, "unit": { "const": "m" } }
      }
    },
    {
      "if": { "properties": { "type": { "enum": ["HKQuantityTypeIdentifierBloodPressureSystolic", "HKQuantityTypeIdentifierBloodPressureDiastolic"] } }, "required": ["type"] },
      "then": {
        "required": ["unit"],
        "properties": { "value": { "type": "number", "exclusiveMinimum": 0, "maximum": 400 }, "unit": { "const": "mmHg" } }
      }
    },
    {
      "if": { "properties": { "type": { "const": "HKQuantityTypeIdentifierBloodGlucose" } }, "required": ["type"] },
      "then": {
        "required": ["unit"],
        "properties": { "value": { "type": "number", "exclusiveMinimum": 0, "maximum": 2000 }, "unit": { "const": "mg/dL" } }
      }
    },
    {
      "if": { "properties": { "type": { "const": "HKQuantityTypeIdentifierBodyMassIndex" } }, "required": ["type"] },
      "then": {
        "required": ["unit"],
        "properties": { "value": { "type": "number", "exclusiveMinimum": 0, "maximum": 200 }, "unit": { "const": "kg/m2" } }
      }
    },
    {
      "if": { "properties": { "type": { "const": "HKWorkoutTypeIdentifier" } }, "required": ["type"] },
      "then": {
        "not": { "required": ["unit"] },
        "required": ["raw"],
        "properties": {
          "value": { "type": "string", "pattern": "^[a-z][A-Za-z0-9]{0,63}$" },
          "raw": { "$ref": "#/$defs/workout_totals" }
        }
      }
    }
  ],
  "$defs": {
    "workout_totals": {
      "description": "A workout's totals as the source reports them. Anything else the source gives may ride along.",
      "type": "object",
      "properties": {
        "duration_s": { "type": "number", "minimum": 0 },
        "energy_kcal": { "type": "number", "minimum": 0 },
        "distance_m": { "type": "number", "minimum": 0 },
        "heart_rate_avg_bpm": { "type": "number", "exclusiveMinimum": 0, "maximum": 300 },
        "heart_rate_max_bpm": { "type": "number", "exclusiveMinimum": 0, "maximum": 300 }
      }
    },
    "device": {
      "description": "The physical device that took the measurement, so baselines can be kept per device.",
      "type": "object",
      "additionalProperties": false,
      "required": ["id"],
      "properties": {
        "id": { "type": "string", "minLength": 1, "maxLength": 200 },
        "name": { "type": "string", "minLength": 1, "maxLength": 200 },
        "manufacturer": { "type": "string", "minLength": 1, "maxLength": 200 },
        "model": { "type": "string", "minLength": 1, "maxLength": 200 }
      }
    }
  }
}
