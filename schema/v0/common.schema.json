{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://raw.githubusercontent.com/byobot/byobot/main/schema/v0/common.schema.json",
  "title": "byobot common definitions, v0",
  "description": "Shared building blocks for the byobot v0 contract. Dates and times are checked with patterns (not only `format`) so every implementation rejects the same strings.",
  "$defs": {
    "id": {
      "description": "A record id. Clients generate ids; UUIDs (v7 preferred, so ids sort by time) or readable slugs both work.",
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$"
    },
    "slug": {
      "description": "A short lowercase name, such as a source name (`whoop`) or an activity id (`barbell_back_squat`).",
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9._-]{0,63}$"
    },
    "uuid": {
      "description": "A lowercase UUID (any version; byobot writes v7).",
      "type": "string",
      "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"
    },
    "timestamp": {
      "description": "An RFC 3339 timestamp with an explicit offset (`Z` or `+hh:mm`).",
      "type": "string",
      "format": "date-time",
      "pattern": "^[0-9]{4}-(0[1-9]|1[0-2])-(0[1-9]|[12][0-9]|3[01])T([01][0-9]|2[0-3]):[0-5][0-9]:[0-5][0-9](\\.[0-9]{1,9})?(Z|[+-]([01][0-9]|2[0-3]):[0-5][0-9])$"
    },
    "date": {
      "description": "A calendar date, `YYYY-MM-DD`, in the user's local calendar.",
      "type": "string",
      "format": "date",
      "pattern": "^[0-9]{4}-(0[1-9]|1[0-2])-(0[1-9]|[12][0-9]|3[01])$"
    },
    "text": {
      "type": "string",
      "minLength": 1,
      "maxLength": 4000
    },
    "metric_name": {
      "description": "A metric from the registry below, or your own prefixed with `x.` (for example `x.grade`).",
      "anyOf": [
        {
          "enum": [
            "reps",
            "load",
            "duration",
            "distance",
            "pace",
            "heart_rate",
            "power",
            "rpe",
            "rir",
            "rest",
            "tempo",
            "incline"
          ]
        },
        {
          "$ref": "#/$defs/custom_metric_name"
        }
      ]
    },
    "custom_metric_name": {
      "type": "string",
      "pattern": "^x\\.[a-z0-9][a-z0-9_.-]{0,62}$"
    },
    "measure": {
      "description": "One measurement: an exact `value`, or a range with `min`, `max` or both (a range with only `min` is 'at least', as in AMRAP). In a plan it is the target; in a log it is what happened. Numbers carry a `unit` where the metric has one.",
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "value": {
          "type": [
            "number",
            "string",
            "boolean"
          ]
        },
        "min": {
          "type": "number"
        },
        "max": {
          "type": "number"
        },
        "unit": {
          "type": "string",
          "minLength": 1,
          "maxLength": 32
        }
      },
      "oneOf": [
        {
          "required": [
            "value"
          ],
          "not": {
            "anyOf": [
              {
                "required": [
                  "min"
                ]
              },
              {
                "required": [
                  "max"
                ]
              }
            ]
          }
        },
        {
          "anyOf": [
            {
              "required": [
                "min"
              ]
            },
            {
              "required": [
                "max"
              ]
            }
          ],
          "not": {
            "required": [
              "value"
            ]
          }
        }
      ]
    },
    "metrics": {
      "description": "What is measured, by metric name. Registry metrics have fixed units and are checked strictly; anything else must be prefixed `x.`, so a typo like `rep` is rejected instead of becoming a new metric.",
      "type": "object",
      "properties": {
        "reps": {
          "description": "Repetitions.",
          "allOf": [
            {
              "$ref": "#/$defs/measure"
            }
          ],
          "properties": {
            "value": {
              "type": "integer",
              "minimum": 0
            },
            "min": {
              "type": "integer",
              "minimum": 0
            },
            "max": {
              "type": "integer",
              "minimum": 0
            }
          },
          "not": {
            "required": [
              "unit"
            ]
          }
        },
        "load": {
          "description": "Weight moved, or a share of your one-rep max.",
          "allOf": [
            {
              "$ref": "#/$defs/measure"
            }
          ],
          "properties": {
            "value": {
              "type": "number",
              "minimum": 0
            },
            "min": {
              "type": "number",
              "minimum": 0
            },
            "max": {
              "type": "number",
              "minimum": 0
            },
            "unit": {
              "enum": [
                "kg",
                "lb",
                "%1rm"
              ]
            }
          },
          "required": [
            "unit"
          ]
        },
        "duration": {
          "description": "How long. On a block, how long each round lasts (an EMOM is 60 s).",
          "allOf": [
            {
              "$ref": "#/$defs/measure"
            }
          ],
          "properties": {
            "value": {
              "type": "number",
              "minimum": 0
            },
            "min": {
              "type": "number",
              "minimum": 0
            },
            "max": {
              "type": "number",
              "minimum": 0
            },
            "unit": {
              "enum": [
                "s",
                "min",
                "h"
              ]
            }
          },
          "required": [
            "unit"
          ]
        },
        "distance": {
          "description": "How far.",
          "allOf": [
            {
              "$ref": "#/$defs/measure"
            }
          ],
          "properties": {
            "value": {
              "type": "number",
              "minimum": 0
            },
            "min": {
              "type": "number",
              "minimum": 0
            },
            "max": {
              "type": "number",
              "minimum": 0
            },
            "unit": {
              "enum": [
                "m",
                "km",
                "mi",
                "yd",
                "ft"
              ]
            }
          },
          "required": [
            "unit"
          ]
        },
        "pace": {
          "description": "Time per distance.",
          "allOf": [
            {
              "$ref": "#/$defs/measure"
            }
          ],
          "properties": {
            "value": {
              "type": "number",
              "minimum": 0
            },
            "min": {
              "type": "number",
              "minimum": 0
            },
            "max": {
              "type": "number",
              "minimum": 0
            },
            "unit": {
              "enum": [
                "s/km",
                "s/mi",
                "s/100m",
                "s/500m"
              ]
            }
          },
          "required": [
            "unit"
          ]
        },
        "heart_rate": {
          "description": "Heart rate.",
          "allOf": [
            {
              "$ref": "#/$defs/measure"
            }
          ],
          "properties": {
            "value": {
              "type": "number",
              "minimum": 0,
              "maximum": 300
            },
            "min": {
              "type": "number",
              "minimum": 0,
              "maximum": 300
            },
            "max": {
              "type": "number",
              "minimum": 0,
              "maximum": 300
            },
            "unit": {
              "enum": [
                "bpm"
              ]
            }
          },
          "required": [
            "unit"
          ]
        },
        "power": {
          "description": "Power output.",
          "allOf": [
            {
              "$ref": "#/$defs/measure"
            }
          ],
          "properties": {
            "value": {
              "type": "number",
              "minimum": 0
            },
            "min": {
              "type": "number",
              "minimum": 0
            },
            "max": {
              "type": "number",
              "minimum": 0
            },
            "unit": {
              "enum": [
                "W"
              ]
            }
          },
          "required": [
            "unit"
          ]
        },
        "rpe": {
          "description": "Rate of perceived exertion, 0 to 10.",
          "allOf": [
            {
              "$ref": "#/$defs/measure"
            }
          ],
          "properties": {
            "value": {
              "type": "number",
              "minimum": 0,
              "maximum": 10
            },
            "min": {
              "type": "number",
              "minimum": 0,
              "maximum": 10
            },
            "max": {
              "type": "number",
              "minimum": 0,
              "maximum": 10
            }
          },
          "not": {
            "required": [
              "unit"
            ]
          }
        },
        "rir": {
          "description": "Reps in reserve.",
          "allOf": [
            {
              "$ref": "#/$defs/measure"
            }
          ],
          "properties": {
            "value": {
              "type": "number",
              "minimum": 0
            },
            "min": {
              "type": "number",
              "minimum": 0
            },
            "max": {
              "type": "number",
              "minimum": 0
            }
          },
          "not": {
            "required": [
              "unit"
            ]
          }
        },
        "rest": {
          "description": "Rest after this effort (or, on a block, between rounds).",
          "allOf": [
            {
              "$ref": "#/$defs/measure"
            }
          ],
          "properties": {
            "value": {
              "type": "number",
              "minimum": 0
            },
            "min": {
              "type": "number",
              "minimum": 0
            },
            "max": {
              "type": "number",
              "minimum": 0
            },
            "unit": {
              "enum": [
                "s",
                "min"
              ]
            }
          },
          "required": [
            "unit"
          ]
        },
        "tempo": {
          "description": "Lifting tempo: eccentric, bottom, concentric, top, e.g. 3010.",
          "type": "object",
          "additionalProperties": false,
          "required": [
            "value"
          ],
          "properties": {
            "value": {
              "type": "string",
              "pattern": "^[0-9xX]{4}$"
            }
          }
        },
        "incline": {
          "description": "Treadmill or ramp incline; negative is a decline.",
          "allOf": [
            {
              "$ref": "#/$defs/measure"
            }
          ],
          "properties": {
            "value": {
              "type": "number"
            },
            "min": {
              "type": "number"
            },
            "max": {
              "type": "number"
            },
            "unit": {
              "enum": [
                "%",
                "deg"
              ]
            }
          },
          "required": [
            "unit"
          ]
        }
      },
      "patternProperties": {
        "^x\\.[a-z0-9][a-z0-9_.-]{0,62}$": {
          "$ref": "#/$defs/measure"
        }
      },
      "additionalProperties": false
    }
  }
}
