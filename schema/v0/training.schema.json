{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://raw.githubusercontent.com/byobot/byobot/main/schema/v0/training.schema.json",
  "title": "byobot training records, v0",
  "description": "Anything physical you plan or do, in one shape. An activity is what you do (a squat, a run, a stretch, tennis). A session is a list of blocks; a block repeats for some rounds and holds efforts; an effort is one activity with metrics. A plan and a log use the same shape: in a plan the metrics are targets, in a log they are what happened, and a logged effort points at the planned effort it answers.",
  "$defs": {
    "activity": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "name"],
      "properties": {
        "id": { "$ref": "common.schema.json#/$defs/slug", "description": "Stable activity id, for example `barbell_back_squat`, `run`, `couch_stretch`, `tennis`." },
        "name": { "type": "string", "minLength": 1, "maxLength": 200 },
        "tags": {
          "description": "Free-form labels, for example `strength`, `legs`, `mobility`, `zone_2`.",
          "type": "array",
          "items": { "$ref": "common.schema.json#/$defs/slug" },
          "uniqueItems": true
        },
        "default_metrics": {
          "description": "What to ask for when logging this activity, for example `reps` and `load` for a squat, `duration` for a plank.",
          "type": "array",
          "items": { "$ref": "common.schema.json#/$defs/metric_name" },
          "uniqueItems": true
        },
        "targets": { "$ref": "#/$defs/targets" },
        "equipment": {
          "description": "What it needs, for example `barbell`, `bench`, `pull_up_bar`. Absent or empty means nothing.",
          "type": "array",
          "items": { "$ref": "common.schema.json#/$defs/slug" },
          "uniqueItems": true
        },
        "movement_type": { "$ref": "common.schema.json#/$defs/slug", "description": "How it moves: `compound` works several joints, `isolation` one. The library uses only these two; your own activities can use any name." },
        "fatigue": { "type": "integer", "minimum": 1, "maximum": 4, "description": "How much it takes out of you, from 1 (little) to 4 (a lot), so a plan can balance a week." },
        "resistance_curve": { "$ref": "#/$defs/resistance_curve" },
        "notes": { "$ref": "common.schema.json#/$defs/text" }
      }
    },
    "targets": {
      "description": "The muscles an activity works: `main` does most of the work, `synergists` help. An app suggests swaps that work the same ones. Use the names in library/vocabulary.json where they fit.",
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "main": { "type": "array", "items": { "$ref": "common.schema.json#/$defs/slug" }, "uniqueItems": true },
        "synergists": { "type": "array", "items": { "$ref": "common.schema.json#/$defs/slug" }, "uniqueItems": true }
      }
    },
    "resistance_curve": {
      "description": "How hard it is at each part of the range, from 1 (easy) to 3 (hardest): `stretch` with the muscle long, `middle`, and `contract` with it short.",
      "type": "object",
      "additionalProperties": false,
      "required": ["stretch", "middle", "contract"],
      "properties": {
        "stretch": { "type": "integer", "minimum": 1, "maximum": 3 },
        "middle": { "type": "integer", "minimum": 1, "maximum": 3 },
        "contract": { "type": "integer", "minimum": 1, "maximum": 3 }
      }
    },
    "location": {
      "description": "Where you train, such as a gym. Loads compare within one location, because the same weight can feel different on another gym's equipment.",
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "name"],
      "properties": {
        "id": { "$ref": "common.schema.json#/$defs/slug", "description": "Stable location id, for example `home`, `example-gym`." },
        "name": { "type": "string", "minLength": 1, "maxLength": 200 },
        "notes": { "$ref": "common.schema.json#/$defs/text" }
      }
    },
    "plan": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "name", "starts_on"],
      "properties": {
        "id": { "$ref": "common.schema.json#/$defs/id" },
        "name": { "type": "string", "minLength": 1, "maxLength": 200 },
        "goal": { "$ref": "common.schema.json#/$defs/text" },
        "starts_on": { "$ref": "common.schema.json#/$defs/date" },
        "ends_on": { "$ref": "common.schema.json#/$defs/date" },
        "notes": { "$ref": "common.schema.json#/$defs/text" }
      }
    },
    "side": {
      "description": "Which side, for unilateral work.",
      "enum": ["left", "right", "both"]
    },
    "planned_effort": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "activity_id"],
      "properties": {
        "id": { "$ref": "common.schema.json#/$defs/id" },
        "activity_id": { "$ref": "common.schema.json#/$defs/slug" },
        "side": { "$ref": "#/$defs/side" },
        "metrics": { "$ref": "common.schema.json#/$defs/metrics", "description": "Targets." },
        "notes": { "$ref": "common.schema.json#/$defs/text" }
      }
    },
    "block": {
      "description": "Efforts done in order, repeated for `rounds`. One effort for 3 rounds is three straight sets; two efforts for 3 rounds is a superset; a block with a 60 s duration per round is an EMOM.",
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "efforts"],
      "properties": {
        "id": { "$ref": "common.schema.json#/$defs/id" },
        "name": { "type": "string", "minLength": 1, "maxLength": 200 },
        "rounds": { "type": "integer", "minimum": 1, "maximum": 1000, "default": 1 },
        "metrics": { "$ref": "common.schema.json#/$defs/metrics", "description": "Per-round targets for the block, such as `duration` for an EMOM or `rest` between rounds." },
        "efforts": { "type": "array", "minItems": 1, "maxItems": 200, "items": { "$ref": "#/$defs/planned_effort" } },
        "notes": { "$ref": "common.schema.json#/$defs/text" }
      }
    },
    "planned_session": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "scheduled_on", "name", "blocks"],
      "properties": {
        "id": { "$ref": "common.schema.json#/$defs/id" },
        "plan_id": { "$ref": "common.schema.json#/$defs/id", "description": "Omit for a one-off session outside any plan." },
        "scheduled_on": { "$ref": "common.schema.json#/$defs/date" },
        "name": { "type": "string", "minLength": 1, "maxLength": 200 },
        "location_id": { "$ref": "common.schema.json#/$defs/slug", "description": "Where the session is meant to happen, so its loads fit that location." },
        "metrics": { "$ref": "common.schema.json#/$defs/metrics", "description": "Targets for the whole session, such as total duration." },
        "blocks": { "type": "array", "minItems": 1, "maxItems": 200, "items": { "$ref": "#/$defs/block" } },
        "notes": { "$ref": "common.schema.json#/$defs/text" }
      }
    },
    "effort_fields": {
      "type": "object",
      "properties": {
        "id": { "$ref": "common.schema.json#/$defs/id" },
        "activity_id": { "$ref": "common.schema.json#/$defs/slug" },
        "performed_at": { "$ref": "common.schema.json#/$defs/timestamp", "description": "When the effort started." },
        "planned_effort_id": { "$ref": "common.schema.json#/$defs/id", "description": "The planned effort this answers. Omit for unplanned work." },
        "round": { "type": "integer", "minimum": 1, "maximum": 1000, "description": "Which round of the planned block this was." },
        "side": { "$ref": "#/$defs/side" },
        "location_id": { "$ref": "common.schema.json#/$defs/slug", "description": "Where it happened. Omit to take the session's." },
        "metrics": { "$ref": "common.schema.json#/$defs/metrics", "description": "What happened." },
        "notes": { "$ref": "common.schema.json#/$defs/text" }
      }
    },
    "performed_effort": {
      "description": "One effort done, logged on its own (as an app logs set by set). `session_id` ties it to a performed session; without one it stands alone, as a 90-minute tennis match can.",
      "type": "object",
      "allOf": [{ "$ref": "#/$defs/effort_fields" }],
      "required": ["id", "activity_id", "performed_at"],
      "properties": {
        "id": true, "activity_id": true, "performed_at": true, "planned_effort_id": true, "round": true, "side": true, "location_id": true, "metrics": true, "notes": true,
        "session_id": { "$ref": "common.schema.json#/$defs/id" }
      },
      "additionalProperties": false
    },
    "inline_effort": {
      "description": "An effort logged inside a performed session. `performed_at` defaults to the session's start.",
      "type": "object",
      "allOf": [{ "$ref": "#/$defs/effort_fields" }],
      "required": ["id", "activity_id"],
      "properties": {
        "id": true, "activity_id": true, "performed_at": true, "planned_effort_id": true, "round": true, "side": true, "location_id": true, "metrics": true, "notes": true
      },
      "additionalProperties": false
    },
    "performed_session": {
      "description": "A session that happened: its totals, and optionally all its efforts at once (as a watch import does). Efforts can also be logged one at a time with `session_id`.",
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "started_at"],
      "properties": {
        "id": { "$ref": "common.schema.json#/$defs/id" },
        "planned_session_id": { "$ref": "common.schema.json#/$defs/id" },
        "plan_id": { "$ref": "common.schema.json#/$defs/id" },
        "name": { "type": "string", "minLength": 1, "maxLength": 200 },
        "started_at": { "$ref": "common.schema.json#/$defs/timestamp" },
        "ended_at": { "$ref": "common.schema.json#/$defs/timestamp" },
        "location_id": { "$ref": "common.schema.json#/$defs/slug", "description": "Where it happened." },
        "metrics": { "$ref": "common.schema.json#/$defs/metrics", "description": "Totals for the session, such as duration, distance or session RPE." },
        "efforts": { "type": "array", "maxItems": 2000, "items": { "$ref": "#/$defs/inline_effort" } },
        "notes": { "$ref": "common.schema.json#/$defs/text" }
      }
    }
  }
}
