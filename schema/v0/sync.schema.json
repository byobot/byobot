{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://raw.githubusercontent.com/byobot/byobot/main/schema/v0/sync.schema.json",
  "title": "byobot LAN sync protocol, v0",
  "description": "The messages `byobot serve` and a paired app exchange, as JSON over HTTPS on the local network. The server is the hub: the app pulls the plan and pushes what it logged. Documents inside these messages (activities, sessions, events, samples) use the training, event and telemetry schemas unchanged. Responses may gain fields in later versions, so clients ignore fields they don't know; requests are strict.",
  "$defs": {
    "server": {
      "type": "object",
      "required": ["device_id", "name"],
      "properties": {
        "device_id": { "$ref": "common.schema.json#/$defs/id", "description": "The server store's device id." },
        "name": { "type": "string", "minLength": 1, "maxLength": 200, "description": "The laptop's name, for display." }
      }
    },
    "device": {
      "description": "A paired device as the server records it.",
      "type": "object",
      "required": ["device_id", "name", "paired_at"],
      "properties": {
        "device_id": { "$ref": "common.schema.json#/$defs/id" },
        "name": { "type": "string", "minLength": 1, "maxLength": 200 },
        "paired_at": { "$ref": "common.schema.json#/$defs/timestamp" },
        "last_seen_at": { "type": ["string", "null"] },
        "revoked_at": { "type": ["string", "null"] }
      }
    },
    "error": {
      "description": "Any non-200 response. `unauthorized` means the app should pair again.",
      "type": "object",
      "required": ["error", "message"],
      "properties": {
        "error": { "type": "string" },
        "message": { "type": "string" },
        "details": {}
      }
    },
    "hello": {
      "description": "GET /v0/hello. No token needed; the app calls it to learn whom it reached before pairing.",
      "type": "object",
      "required": ["byobot", "protocol", "schema_version", "server", "pairing_open"],
      "properties": {
        "byobot": { "type": "string", "description": "The server's byobot version." },
        "protocol": { "const": 0 },
        "schema_version": { "const": 0 },
        "server": { "$ref": "#/$defs/server" },
        "pairing_open": { "type": "boolean" }
      }
    },
    "pair_request": {
      "description": "POST /v0/pair. Trade the one-time code for a token.",
      "type": "object",
      "additionalProperties": false,
      "required": ["code", "device_id", "name"],
      "properties": {
        "code": { "type": "string", "pattern": "^[0-9]{6}$" },
        "device_id": { "$ref": "common.schema.json#/$defs/id", "description": "The app install's own device id, which its events carry." },
        "name": { "type": "string", "minLength": 1, "maxLength": 200, "description": "The phone's name, for `byobot devices`." }
      }
    },
    "pair_response": {
      "type": "object",
      "required": ["token", "server", "device"],
      "properties": {
        "token": { "type": "string", "minLength": 32, "description": "Send as `Authorization: Bearer <token>` from now on. Keep it in the keychain." },
        "server": { "$ref": "#/$defs/server" },
        "device": { "$ref": "#/$defs/device" }
      }
    },
    "status": {
      "description": "GET /v0/status. A cheap authenticated check.",
      "type": "object",
      "required": ["server", "device", "counts", "today"],
      "properties": {
        "server": { "$ref": "#/$defs/server" },
        "device": { "$ref": "#/$defs/device" },
        "counts": { "type": "object", "additionalProperties": { "type": "integer" } },
        "today": { "$ref": "common.schema.json#/$defs/date", "description": "The server's local date." }
      }
    },
    "plan_window": {
      "description": "GET /v0/plan?from=YYYY-MM-DD&to=YYYY-MM-DD (both optional; by default yesterday through 13 days ahead). Activities, locations, plans and planned sessions exactly as their current events wrote them, the efforts already logged against those sessions (from any device), and for each activity planned in the window the efforts of the last two sessions it was done in at each location, so the app can show last time. An effort without a location of its own carries its session's.",
      "type": "object",
      "required": ["from", "to", "activities", "plans", "sessions", "efforts"],
      "properties": {
        "from": { "$ref": "common.schema.json#/$defs/date" },
        "to": { "$ref": "common.schema.json#/$defs/date" },
        "activities": { "type": "array", "items": { "$ref": "training.schema.json#/$defs/activity" } },
        "locations": { "type": "array", "items": { "$ref": "training.schema.json#/$defs/location" } },
        "plans": { "type": "array", "items": { "$ref": "training.schema.json#/$defs/plan" } },
        "sessions": { "type": "array", "items": { "$ref": "training.schema.json#/$defs/planned_session" } },
        "efforts": { "type": "array", "items": { "$ref": "training.schema.json#/$defs/performed_effort" } }
      }
    },
    "events_request": {
      "description": "POST /v0/events. Events authored on the app, oldest first. Each must carry the paired device's id and the actor human/me; a different device or actor is rejected.",
      "type": "object",
      "additionalProperties": false,
      "required": ["events"],
      "properties": {
        "events": { "type": "array", "maxItems": 2000, "items": { "$ref": "event.schema.json" } }
      }
    },
    "event_result": {
      "type": "object",
      "required": ["index", "id", "status"],
      "properties": {
        "index": { "type": "integer", "minimum": 0 },
        "id": { "type": ["string", "null"] },
        "status": {
          "description": "`accepted` and `duplicate` both mean the server has it, so the app can forget it. `rejected` will not change on retry.",
          "enum": ["accepted", "duplicate", "rejected"]
        },
        "errors": { "type": "array" }
      }
    },
    "events_response": {
      "type": "object",
      "required": ["results", "accepted", "duplicate", "rejected"],
      "properties": {
        "results": { "type": "array", "items": { "$ref": "#/$defs/event_result" } },
        "accepted": { "type": "integer", "minimum": 0 },
        "duplicate": { "type": "integer", "minimum": 0 },
        "rejected": { "type": "integer", "minimum": 0 }
      }
    },
    "telemetry_request": {
      "description": "POST /v0/telemetry. Samples read on the phone, such as body mass from HealthKit. Sending a sample again changes nothing.",
      "type": "object",
      "additionalProperties": false,
      "required": ["samples"],
      "properties": {
        "samples": { "type": "array", "maxItems": 2000, "items": { "$ref": "telemetry.schema.json" } }
      }
    },
    "telemetry_response": {
      "type": "object",
      "required": ["inserted", "updated", "unchanged", "rejected"],
      "properties": {
        "inserted": { "type": "integer", "minimum": 0 },
        "updated": { "type": "integer", "minimum": 0 },
        "unchanged": { "type": "integer", "minimum": 0 },
        "rejected": { "type": "array", "items": { "type": "object", "required": ["index", "errors"] } }
      }
    }
  }
}
