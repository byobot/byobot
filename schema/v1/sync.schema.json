{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://raw.githubusercontent.com/byobot/byobot/v0.1.0/schema/v1/sync.schema.json",
  "title": "byobot LAN sync protocol, v1",
  "description": "The messages `byobot serve` and a paired app exchange, as JSON over HTTPS on the local network. The server is the hub: the app pulls the plan and events, and pushes the events it authored and the health samples it read. Responses may gain fields in later versions, so clients ignore fields they don't know; requests are strict.",
  "$defs": {
    "server": {
      "type": "object",
      "required": [
        "device_id",
        "store_id",
        "name"
      ],
      "properties": {
        "device_id": {
          "$ref": "common.schema.json#/$defs/id",
          "description": "The server store's device id."
        },
        "store_id": {
          "$ref": "common.schema.json#/$defs/uuid",
          "description": "The store's id. An app paired with another store pairs again."
        },
        "name": {
          "$ref": "common.schema.json#/$defs/name",
          "description": "The laptop's name, for display."
        }
      }
    },
    "device": {
      "description": "A paired device as the server records it.",
      "type": "object",
      "required": [
        "device_id",
        "name",
        "paired_at"
      ],
      "properties": {
        "device_id": {
          "$ref": "common.schema.json#/$defs/id"
        },
        "name": {
          "$ref": "common.schema.json#/$defs/name"
        },
        "paired_at": {
          "$ref": "common.schema.json#/$defs/timestamp"
        },
        "last_seen_at": {
          "type": [
            "string",
            "null"
          ]
        },
        "revoked_at": {
          "type": [
            "string",
            "null"
          ]
        }
      }
    },
    "error": {
      "description": "Any non-200 response. `unauthorized` means the app should pair again.",
      "type": "object",
      "required": [
        "error",
        "message"
      ],
      "properties": {
        "error": {
          "type": "string"
        },
        "message": {
          "type": "string"
        },
        "details": {}
      }
    },
    "kinds": {
      "type": "object",
      "description": "The newest version of each kind a side knows, by kind.",
      "propertyNames": {
        "$ref": "common.schema.json#/$defs/kind"
      },
      "additionalProperties": {
        "type": "integer",
        "minimum": 1,
        "maximum": 1000
      }
    },
    "hello": {
      "description": "GET /v1/hello. No token needed; the app calls it to learn whom it reached before pairing.",
      "type": "object",
      "required": [
        "byobot",
        "protocol",
        "schema_version",
        "server",
        "pairing_open"
      ],
      "properties": {
        "byobot": {
          "type": "string",
          "description": "The server's byobot version."
        },
        "protocol": {
          "const": 1
        },
        "schema_version": {
          "const": 1
        },
        "server": {
          "$ref": "#/$defs/server"
        },
        "pairing_open": {
          "type": "boolean"
        },
        "kinds": {
          "$ref": "#/$defs/kinds",
          "description": "The server's kind versions."
        }
      }
    },
    "pair_request": {
      "description": "POST /v1/pair. Trade the one-time code for a token.",
      "type": "object",
      "required": [
        "code",
        "device_id",
        "name"
      ],
      "properties": {
        "code": {
          "type": "string",
          "pattern": "^[0-9]{6}$"
        },
        "device_id": {
          "$ref": "common.schema.json#/$defs/id",
          "description": "The app install's own device id, which its events carry."
        },
        "name": {
          "$ref": "common.schema.json#/$defs/name",
          "description": "The phone's name, for `byobot devices list`."
        }
      },
      "additionalProperties": false
    },
    "pair_response": {
      "type": "object",
      "required": [
        "token",
        "server",
        "device"
      ],
      "properties": {
        "token": {
          "type": "string",
          "minLength": 32,
          "description": "Send as `Authorization: Bearer <token>` from now on. Keep it in the keychain."
        },
        "server": {
          "$ref": "#/$defs/server"
        },
        "device": {
          "$ref": "#/$defs/device"
        }
      }
    },
    "status": {
      "description": "GET /v1/status. A cheap authenticated check.",
      "type": "object",
      "required": [
        "server",
        "device",
        "counts",
        "today"
      ],
      "properties": {
        "server": {
          "$ref": "#/$defs/server"
        },
        "device": {
          "$ref": "#/$defs/device"
        },
        "counts": {
          "type": "object",
          "additionalProperties": {
            "type": "integer"
          }
        },
        "today": {
          "$ref": "common.schema.json#/$defs/date",
          "description": "The server's local date."
        }
      }
    },
    "entry": {
      "description": "A live record as the app keeps it.",
      "type": "object",
      "required": [
        "id",
        "payload",
        "prev"
      ],
      "properties": {
        "id": {
          "$ref": "common.schema.json#/$defs/id"
        },
        "payload": {
          "type": "object",
          "description": "The record's current payload, as its kind's schema writes it."
        },
        "prev": {
          "type": "array",
          "items": {
            "$ref": "common.schema.json#/$defs/uuid"
          },
          "uniqueItems": true,
          "description": "The events to name as `prev` in a change to this record. Empty for a library activity."
        },
        "conflict": {
          "const": true,
          "description": "Two writers changed it at once; this is the version reads show."
        },
        "library": {
          "const": true,
          "description": "An activity that ships with byobot, not yet written to the logbook."
        },
        "kind_version": {
          "type": "integer",
          "minimum": 1,
          "maximum": 1000,
          "description": "The kind version its payload needs (1 when absent). An app that knows a lower one leaves the record as it is."
        }
      }
    },
    "erased_record": {
      "type": "object",
      "required": [
        "kind",
        "id"
      ],
      "properties": {
        "kind": {
          "$ref": "common.schema.json#/$defs/kind"
        },
        "id": {
          "$ref": "common.schema.json#/$defs/id"
        }
      }
    },
    "rejection": {
      "description": "An event the hub refused. Sending it again won't change that.",
      "type": "object",
      "required": [
        "id",
        "reason"
      ],
      "properties": {
        "id": {
          "type": "string"
        },
        "reason": {
          "type": "string"
        }
      }
    },
    "plan_window": {
      "description": "GET /v1/plan?from=YYYY-MM-DD&to=YYYY-MM-DD (both optional; by default yesterday through 13 days ahead). Everything the app needs to run the sessions scheduled in the window, each record with the versions a change to it names as prev. A hub older than `store_id`, `hlc`, `erased`, `kind_versions`, `received` and `rejected` sends none of them, and the app then skips what they drive.",
      "type": "object",
      "required": [
        "from",
        "to",
        "activities",
        "locations",
        "settings",
        "plans",
        "planned_sessions",
        "sessions",
        "efforts"
      ],
      "properties": {
        "from": {
          "$ref": "common.schema.json#/$defs/date"
        },
        "to": {
          "$ref": "common.schema.json#/$defs/date"
        },
        "since": {
          "$ref": "common.schema.json#/$defs/date",
          "description": "The first day of logged history the plan carries: sessions on or after it through `to`, and their efforts."
        },
        "activities": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/entry"
          }
        },
        "locations": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/entry"
          }
        },
        "settings": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/entry"
          },
          "description": "equipment, current_location and home_zone, where set."
        },
        "plans": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/entry"
          }
        },
        "planned_sessions": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/entry"
          }
        },
        "sessions": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/entry"
          },
          "description": "Sessions logged against the planned sessions in the window, those from `since` through `to`, and those holding the last two times each activity was done at each location."
        },
        "efforts": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/entry"
          },
          "description": "The efforts of those sessions, those logged against the planned sessions, and those outside a session from `since` through `to`."
        },
        "store_id": {
          "$ref": "common.schema.json#/$defs/uuid",
          "description": "The store's id as of this request. It changes when the laptop's store is restored from another store's backup; the app keeps what it has sent per store."
        },
        "hlc": {
          "$ref": "common.schema.json#/$defs/hlc",
          "description": "The hub's clock. The app writes its next events after it."
        },
        "erased": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/erased_record"
          },
          "description": "Records a person writes that were erased. The app drops what it holds of them."
        },
        "kind_versions": {
          "$ref": "#/$defs/kinds",
          "description": "The hub's kind versions."
        },
        "received": {
          "type": "object",
          "propertyNames": {
            "$ref": "common.schema.json#/$defs/id"
          },
          "additionalProperties": {
            "$ref": "common.schema.json#/$defs/hlc"
          },
          "description": "By device id, the clock reading of the latest of its events the hub holds; the asking device's only. The app sends again what it wrote after it, so a hub restored from an older backup ends complete. It shows what was lost only until the device pushes something newer, so a device reads the plan before it pushes. A device the hub holds nothing from is absent."
        },
        "rejected": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/rejection"
          },
          "description": "The asking device's events the hub refused, newest first."
        }
      }
    },
    "events_request": {
      "description": "POST /v1/events. Events authored on the app, oldest first. Each must carry the paired device's id and the actor human/me, and write a kind a person writes (activity, location, setting, plan, planned_session, session, effort, observation, overlay) with op put or retract.",
      "type": "object",
      "required": [
        "events"
      ],
      "properties": {
        "events": {
          "type": "array",
          "maxItems": 2000,
          "items": {
            "$ref": "event.schema.json"
          }
        },
        "kinds": {
          "$ref": "#/$defs/kinds",
          "description": "The app's kind versions (all 1 when absent). The server rejects a put on top of a version the app doesn't know."
        }
      },
      "additionalProperties": false
    },
    "event_result": {
      "type": "object",
      "required": [
        "index",
        "id",
        "status"
      ],
      "properties": {
        "index": {
          "type": "integer",
          "minimum": 0
        },
        "id": {
          "type": [
            "string",
            "null"
          ]
        },
        "status": {
          "enum": [
            "accepted",
            "duplicate",
            "stored_unprojected",
            "rejected"
          ],
          "description": "All but `rejected` mean the server has it, so the app can forget it. `rejected` will not change on retry."
        },
        "reason": {
          "type": "string"
        }
      }
    },
    "events_response": {
      "type": "object",
      "required": [
        "results",
        "accepted",
        "duplicate",
        "stored_unprojected",
        "rejected"
      ],
      "properties": {
        "results": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/event_result"
          }
        },
        "accepted": {
          "type": "integer",
          "minimum": 0
        },
        "duplicate": {
          "type": "integer",
          "minimum": 0
        },
        "stored_unprojected": {
          "type": "integer",
          "minimum": 0
        },
        "rejected": {
          "type": "integer",
          "minimum": 0
        }
      }
    },
    "pull_response": {
      "description": "GET /v1/events?after=N. Events in the order this server received them, after position N (0 for all).",
      "type": "object",
      "required": [
        "events",
        "next",
        "more"
      ],
      "properties": {
        "events": {
          "type": "array",
          "maxItems": 5000,
          "items": {
            "anyOf": [
              {
                "$ref": "event.schema.json"
              },
              {
                "$ref": "event.schema.json#/$defs/later"
              }
            ]
          }
        },
        "next": {
          "type": "integer",
          "minimum": 0,
          "description": "Pass as `after` next time."
        },
        "more": {
          "type": "boolean",
          "description": "Pull again at once: there are more after `next`."
        }
      }
    },
    "sample": {
      "description": "One sample as the app reads it from a health store. A Mac drops a field it doesn't know, so one a newer app adds changes no revision.",
      "type": "object",
      "required": [
        "source",
        "source_id",
        "type",
        "start"
      ],
      "properties": {
        "source": {
          "$ref": "common.schema.json#/$defs/slug",
          "description": "Where the sample was read, such as apple_health."
        },
        "source_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 200,
          "description": "Its id in that health store, such as a HealthKit UUID."
        },
        "type": {
          "type": "string",
          "minLength": 1,
          "maxLength": 200,
          "description": "Its type there, such as HKQuantityTypeIdentifierBodyMass."
        },
        "start": {
          "$ref": "common.schema.json#/$defs/timestamp"
        },
        "end": {
          "$ref": "common.schema.json#/$defs/timestamp"
        },
        "value": {
          "type": [
            "number",
            "string"
          ]
        },
        "unit": {
          "type": "string",
          "maxLength": 32
        },
        "device": {
          "type": "string",
          "maxLength": 200,
          "description": "The device or app that recorded it."
        },
        "origin_app": {
          "type": "string",
          "maxLength": 200,
          "description": "The bundle id of the app that wrote it to the health store, such as com.example.scale."
        },
        "raw": {
          "type": "object",
          "description": "Anything else the health store gave, such as a workout's totals. A running total sent again during the day carries its `modified_at`."
        }
      },
      "additionalProperties": false
    },
    "deletion": {
      "description": "A sample the health store says was deleted.",
      "type": "object",
      "required": [
        "source",
        "source_id"
      ],
      "properties": {
        "source": {
          "$ref": "common.schema.json#/$defs/slug"
        },
        "source_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 200
        },
        "type": {
          "type": "string",
          "minLength": 1,
          "maxLength": 200
        }
      },
      "additionalProperties": false
    },
    "samples_request": {
      "description": "POST /v1/samples. At most 2000 samples and deletions in all. Each source's are written all or none; sending the same again changes nothing.",
      "type": "object",
      "required": [],
      "properties": {
        "samples": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/sample"
          }
        },
        "deleted": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/deletion"
          }
        }
      },
      "additionalProperties": false
    },
    "samples_response": {
      "type": "object",
      "required": [
        "written",
        "by_source"
      ],
      "properties": {
        "written": {
          "type": "integer",
          "minimum": 0
        },
        "by_source": {
          "type": "object",
          "additionalProperties": {
            "type": "integer",
            "minimum": 0
          }
        }
      }
    }
  }
}
